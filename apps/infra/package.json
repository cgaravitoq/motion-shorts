{
  "name": "@cgaravitoq/infra",
  "version": "0.1.0",
  "description": "Cloudflare infrastructure as Effect code (Alchemy v2): R2 bucket + upload-gateway Worker. In-source TypeScript — no compile step.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "plan": "bun alchemy plan alchemy.run.ts --env-file ../../.env",
    "deploy": "bun alchemy deploy alchemy.run.ts --env-file ../../.env",
    "deploy:e2e": "bun alchemy deploy alchemy.run.ts --stage e2e --yes --env-file ../../.env",
    "destroy:e2e": "bun alchemy destroy alchemy.run.ts --stage e2e --env-file ../../.env",
    "e2e": "bun run src/e2e.ts"
  },
  "dependencies": {
    "alchemy": "2.0.0-beta.52",
    "effect": "4.0.0-beta.78",
    "@effect/platform-bun": "4.0.0-beta.78",
    "@effect/platform-node": "4.0.0-beta.78"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
