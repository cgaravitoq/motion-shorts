<!doctype html>
<!-- catalog: [__CATALOG_IDS__] -->
<html lang="__LANG__">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=__WIDTH__, height=__HEIGHT__" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
    <style>
__TEMPLATE_CSS__
    </style>
  </head>
  <body>
    <div id="ep-stage" data-composition-id="__SLUG__" data-start="0" data-duration="__TOTAL_DURATION__" data-width="__WIDTH__" data-height="__HEIGHT__">
      <div id="bg-field" class="bg-field clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="0" style="position:absolute; inset:0;"></div>
      <div id="bg-grid" class="bg-grid clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="1" style="position:absolute; inset:0;"></div>
      <div id="bg-grain" class="hf-grain-overlay clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="2" style="position:absolute; inset:0;"><div class="hf-grain-overlay__texture"></div></div>
      <div id="bg-vignette" class="vignette clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="3" style="position:absolute; inset:0;"></div>
      __BRAND_WATERMARK__

      <section id="scene-hook" class="scene clip" data-start="0" data-duration="7.55" data-track-index="4" style="position:absolute; inset:0;">
        <div class="scene-pad">
          <div id="hook-source" class="source-pill"><span class="hf-source-attribution-strip__mark">__SOURCE_MARK__</span><span class="hf-source-attribution-strip__label">__SOURCE_LABEL__</span></div>
          <h1 id="hook-headline" class="headline">__HOOK_TITLE_HTML__</h1>
          <p id="hook-subtitle" class="subcopy">__HOOK_SUBTITLE__</p>
          <article id="hook-card" class="hf-source-article-hero hf-shimmer-sweep">
            <div class="hf-source-article-hero__top">
              <div class="hf-source-article-hero__publisher"><span class="hf-source-article-hero__logo">__SOURCE_MARK__</span><span>__SOURCE_PUBLISHER__</span></div>
              <span class="hf-source-article-hero__path">__SOURCE_PATH__</span>
            </div>
            <h2 class="hf-source-article-hero__title">__PROOF_TITLE__</h2>
            <div class="hf-source-article-hero__image"><div class="hf-shimmer-sweep__mask"></div></div>
            <div class="hf-source-attribution-strip"><span class="hf-source-attribution-strip__mark">__SOURCE_MARK__</span><span class="hf-source-attribution-strip__label">Source: __SOURCE_LABEL__</span></div>
          </article>
        </div>
      </section>

      <section id="scene-proof" class="scene clip" data-start="7.55" data-duration="6.7" data-track-index="5" style="position:absolute; inset:0;">
        <div class="scene-pad">
          <p id="proof-eyebrow" class="eyebrow">Fuente publica</p>
          <div class="metric-number" id="proof-number">__PROOF_METRIC__<span>__PROOF_METRIC_SUFFIX__</span></div>
          <h2 id="proof-headline" class="headline">__PROOF_TITLE__</h2>
          <p id="proof-subcopy" class="subcopy">__PROOF_BODY__</p>
        </div>
      </section>

      <section id="scene-support" class="scene clip" data-start="14.25" data-duration="7.4" data-track-index="6" style="position:absolute; inset:0;">
        <div class="scene-pad">
          <p id="support-eyebrow" class="eyebrow">La evidencia mantiene contexto</p>
          <h2 id="support-headline" class="headline">La fuente no es decoracion.</h2>
          <aside class="hf-source-proof-card">
            <div class="hf-source-proof-card__header">
              <div class="hf-source-proof-card__avatar">__SOURCE_MARK__</div>
              <div><span class="hf-source-proof-card__name">__SUPPORT_NAME__</span><span class="hf-source-proof-card__role">__SUPPORT_ROLE__</span></div>
            </div>
            <p class="hf-source-proof-card__claim">__SUPPORT_CLAIM__</p>
            <div class="hf-source-attribution-strip"><span class="hf-source-attribution-strip__mark">__SOURCE_MARK__</span><span class="hf-source-attribution-strip__label">Attribution: __SOURCE_LABEL__</span></div>
          </aside>
        </div>
      </section>

      <section id="scene-comparison" class="scene clip" data-start="21.65" data-duration="7.9" data-track-index="5" style="position:absolute; inset:0;">
        <div class="scene-pad">
          <p id="comparison-eyebrow" class="eyebrow">Patron versionado</p>
          <h2 id="comparison-headline" class="headline">Misma gramatica, nueva fuente.</h2>
          <div class="hf-source-stat-comparison">
            __COMPARISON_ROWS__
            <div class="hf-source-attribution-strip"><span class="hf-source-attribution-strip__mark">__SOURCE_MARK__</span><span class="hf-source-attribution-strip__label">Claim label: __SOURCE_LABEL__</span></div>
          </div>
        </div>
      </section>

      <section id="scene-payoff" class="scene clip" data-start="29.55" data-duration="6.2" data-track-index="8" style="position:absolute; inset:0;">
        <div class="scene-pad">
          <p id="payoff-eyebrow" class="eyebrow">La nueva restriccion</p>
          <h2 id="payoff-headline" class="headline">__PAYOFF_TITLE__</h2>
          <div class="constraint">
            <div class="constraint-card"><small>Antes</small><strong>__PAYOFF_BEFORE__</strong></div>
            <div class="constraint-card --accent"><small>Ahora</small><strong>__PAYOFF_AFTER__</strong></div>
          </div>
        </div>
      </section>

      __BRAND_OUTRO__

      <audio id="voiceover" class="clip" data-start="0" data-duration="__AUDIO_DURATION__" data-track-index="98" data-volume="1" src="assets/voice.mp3"></audio>
      <div id="captions" class="clip" data-start="0" data-duration="__AUDIO_DURATION__" data-track-index="99"></div>
    </div>
    <script type="application/json" id="captions-data">[]</script>
    <script src="lib/captions-karaoke.js"></script>
    <script>
__TIMELINE_JS__
    </script>
  </body>
</html>
