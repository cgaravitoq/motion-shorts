{
  "id": "hook@1",
  "type": "hook",
  "version": 1,
  "label": "Opening hook",
  "description": "Full-frame opening statement: optional eyebrow, a large headline, and an optional subcopy line. The attention-grabbing first beat.",
  "builder": "build_hook",
  "classPrefix": "hk",
  "defaultDuration": 6,
  "intentTags": ["informative", "workflow", "data", "social", "brand", "vfx"],
  "slots": {
    "eyebrow": { "kind": "text", "required": false, "default": "" },
    "title": { "kind": "richText", "required": true },
    "subtitle": { "kind": "text", "required": false, "default": "" },
    "image": { "kind": "text", "required": false, "default": "" }
  },
  "validation": [
    "section #scene-<id> present",
    "all timeline selectors scoped to #scene-<id>"
  ]
}
