{
  "id": "code@1",
  "type": "code",
  "version": 1,
  "label": "Code / terminal window",
  "description": "A terminal-style window (the window is the scene object) with a title bar of three traffic-light dots and an optional filename, plus 1-12 syntax-tinted code lines. Optional eyebrow and title above the window. Lines reveal with a typing-like stagger.",
  "builder": "build_code",
  "classPrefix": "cd",
  "layout": "centered",
  "defaultDuration": 7,
  "intentTags": [
    "informative",
    "workflow",
    "data",
    "vfx"
  ],
  "slots": {
    "eyebrow": {
      "kind": "text",
      "required": false,
      "default": ""
    },
    "title": {
      "kind": "richText",
      "required": false,
      "default": ""
    },
    "filename": {
      "kind": "text",
      "required": false,
      "default": ""
    },
    "lines": {
      "kind": "repeat",
      "min": 1,
      "max": 12,
      "item": {
        "text": {
          "kind": "text",
          "required": true
        },
        "kind": {
          "kind": "text",
          "required": false,
          "default": "plain"
        }
      }
    }
  },
  "validation": [
    "section #scene-<id> present",
    "line count within [1,12]",
    "all timeline selectors scoped to #scene-<id>"
  ]
}
