{
  "id": "title-cards@1",
  "type": "title-cards",
  "version": 1,
  "label": "Title + cards grid",
  "description": "A headline with an eyebrow and a responsive grid of 2-6 labeled cards. Card count is a parameter; layout and stagger adapt automatically.",
  "builder": "build_titleCards",
  "classPrefix": "tc",
  "defaultDuration": 7,
  "intentTags": ["informative", "workflow", "data", "brand"],
  "slots": {
    "eyebrow": { "kind": "text", "required": false, "default": "" },
    "title": { "kind": "richText", "required": true },
    "cards": {
      "kind": "repeat",
      "min": 2,
      "max": 6,
      "item": {
        "title": { "kind": "text", "required": true },
        "body": { "kind": "text", "required": false, "default": "" }
      }
    }
  },
  "validation": [
    "section #scene-<id> present",
    "card count within [2,6]",
    "all timeline selectors scoped to #scene-<id>"
  ]
}
