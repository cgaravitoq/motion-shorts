<!doctype html>
<!-- catalog: [__CATALOG_IDS__] -->
<html lang="__LANG__">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=__WIDTH__, height=__HEIGHT__" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@500;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
    <style>
__TEMPLATE_CSS__
    </style>
  </head>
  <body>
    <div id="ep-stage" data-composition-id="__SLUG__" data-start="0" data-duration="__TOTAL_DURATION__" data-width="__WIDTH__" data-height="__HEIGHT__">
      <div id="bg-grid" class="bg-grid clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="0" style="position:absolute; inset:0;"></div>
      <div id="bg-vignette" class="bg-vignette clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="1" style="position:absolute; inset:0;"></div>
      __BRAND_WATERMARK__

      <div class="content-region">
        <div id="story-rail" class="story-rail">
          <div class="rail-base"></div>
          <div id="rail-progress" class="rail-progress"></div>
          <div class="rail-dot"></div>
          <div class="rail-dot"></div>
          <div class="rail-dot"></div>
          <div class="rail-dot"></div>
          <div class="rail-dot"></div>
        </div>

        <section id="scene-hook" class="scene clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="2" style="position:absolute; inset:0;">
          <div class="scene-inner">
            <div class="concept-board">
              <div id="claim-primary" class="claim-card claim-card--primary">
                <small>primary claim</small>
                <b>__HOOK_TITLE_HTML__</b>
                <small>__HOOK_SUBTITLE__</small>
              </div>
              <div id="swap-link" class="swap-link"><span class="swap-chip">behavior test</span></div>
              <div id="claim-layout" class="claim-card claim-card--layout">
                <small>structure</small>
                <b>30 / 70</b>
                <small>avatar below, motion canvas above</small>
              </div>
            </div>
            <div class="signal-strip">
              <div class="signal-pill">Provider-neutral MP4</div>
              <div class="signal-pill">Full-width avatar band</div>
              <div class="signal-pill">Scene motion owns the idea</div>
            </div>
          </div>
        </section>

        <section id="scene-pipeline" class="scene clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="3" style="position:absolute; inset:0;">
          <div class="scene-inner">
            <div class="pipeline-canvas">
              <div class="pipeline-track"><div id="pipeline-line" class="pipeline-line"></div></div>
              <div id="pipeline-pulse" class="pipeline-pulse"></div>
              <div class="pipeline-nodes">
                <div class="pipeline-node"><b>Input</b><span>topic and script</span></div>
                <div class="pipeline-node"><b>Audio</b><span>voiceover</span></div>
                <div class="pipeline-node"><b>Avatar</b><span>provider MP4</span></div>
                <div class="pipeline-node"><b>Short</b><span>single layout</span></div>
              </div>
              <div id="route-lock" class="route-lock">__PROOF_TITLE__</div>
            </div>
          </div>
        </section>

        <section id="scene-loop" class="scene clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="4" style="position:absolute; inset:0;">
          <div class="scene-inner">
            <div class="loop-canvas">
              <svg class="loop-edge hf-flowchart__svg svg-path-draw" viewBox="0 0 820 740" aria-hidden="true">
                <path id="loop-path" class="loop-path hf-flowchart__edge svg-path-draw__path" d="M410 158 C682 158 728 310 616 432 C508 620 312 620 204 432 C92 310 138 158 410 158" />
              </svg>
              <div id="state-core" class="state-core">30%<br />Avatar</div>
              <div id="loop-goal" class="loop-node"><b>Source</b><span>any provider MP4</span></div>
              <div id="loop-decide" class="loop-node"><b>Crop</b><span>object-position</span></div>
              <div id="loop-act" class="loop-node"><b>Sync</b><span>audio duration</span></div>
              <div id="loop-observe" class="loop-node"><b>Render</b><span>fixed frame seek</span></div>
            </div>
          </div>
        </section>

        <section id="scene-rule" class="scene clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="5" style="position:absolute; inset:0;">
          <div class="scene-inner">
            <div class="split-board">
              <div class="split-card split-card--canvas">
                <b>Canvas</b>
                <ul>
                  <li>top 70 percent is diagrams and assets</li>
                  <li>no headline block competing with the speaker</li>
                  <li>scene objects carry the explanation</li>
                </ul>
              </div>
              <div class="split-card split-card--avatar">
                <b>Avatar</b>
                <ul>
                  <li>bottom 30 percent stays full width</li>
                  <li>video wrapper is not timed</li>
                  <li>video element is timed for seek-safe render</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <section id="scene-payoff" class="scene clip" data-start="0" data-duration="__TOTAL_DURATION__" data-track-index="6" style="position:absolute; inset:0;">
          <div class="scene-inner">
            <div class="matrix">
              <div class="matrix-card">
                <small>Use when</small>
                <b>__PAYOFF_TITLE__</b>
                <span>__PROOF_BODY__</span>
              </div>
              <div class="matrix-card matrix-card--strong">
                <small>Swap</small>
                <b>avatar source</b>
                <span>__SUPPORT_CLAIM__</span>
              </div>
              <div class="matrix-card">
                <small>Before</small>
                <b>__PAYOFF_BEFORE__</b>
                <span>manual framing per short</span>
              </div>
              <div class="matrix-card">
                <small>After</small>
                <b>__PAYOFF_AFTER__</b>
                <span>same layout contract every time</span>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div id="avatar-dock" class="avatar-dock">
        <div class="dock-line"></div>
        <div id="avatar-frame" class="avatar-frame">
          <video id="avatar-video" src="__AVATAR_SRC__" style="object-position: __AVATAR_OBJECT_POSITION__;" data-start="0" data-duration="__AVATAR_DURATION__" data-track-index="8" playsinline muted preload="auto"></video>
        </div>
        <div class="avatar-shade"></div>
      </div>

      __BRAND_OUTRO__

      <audio id="voiceover" class="clip" data-start="0" data-duration="__AUDIO_DURATION__" data-track-index="98" data-volume="1" src="assets/voice.mp3"></audio>
      <div id="captions" class="clip" data-start="0" data-duration="__AUDIO_DURATION__" data-track-index="99"></div>
    </div>
    <script type="application/json" id="captions-data">[]</script>
    <script src="lib/captions-karaoke.js"></script>
    <script>
__TIMELINE_JS__
    </script>
  </body>
</html>
