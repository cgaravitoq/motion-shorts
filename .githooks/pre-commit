#!/usr/bin/env bash
set -euo pipefail

scripts/check-no-process-env.sh
scripts/check-env-example.sh

# Validate any staged scene-spec.json against the scene-type manifests.
staged_specs=$(git diff --cached --name-only --diff-filter=ACMR -- 'apps/hyperframe/src/episodes/**/scene-spec.json')
if [[ -n "$staged_specs" ]]; then
  abs_specs=()
  while IFS= read -r spec; do
    [[ -z "$spec" ]] && continue
    abs_specs+=("$PWD/$spec")
  done <<< "$staged_specs"
  bun run --cwd apps/hyperframe scene:check "${abs_specs[@]}"
fi
