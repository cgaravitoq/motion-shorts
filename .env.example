# Audio generation
TTS_PROVIDER=elevenlabs
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_VOICE_ID_ES=replace-me
ELEVENLABS_VOICE_ID_EN=replace-me
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_SCRIBE_MODEL=scribe_v2

# Optional alternate TTS provider
INWORLD_API_KEY=
INWORLD_VOICE_ID_ES=
INWORLD_VOICE_ID_EN=
INWORLD_TTS_MODEL=inworld-tts-2

# Brand lockup for scaffolded episodes — read by `bun run new:episode` and
# written into the outro scene's wordmark/tagline slots (defaults: cgaravitoq /
# AI Engineering). Existing episodes: set the slots in scene-spec.json instead.
BRAND_NAME=cgaravitoq
BRAND_TAGLINE="AI Engineering"

# HeyGen avatar workflow (optional — only needed for the short-talking-head skill).
# Required by the upstream `heygen-avatar` and `heygen-video` Hyperframes skills:
#   bunx hyperframes skills install heygen-avatar heygen-video
# Any other presenter MP4 (webcam, D-ID, Synthesia, Veo) works without this key —
# `hyperframes remove-background` is provider-agnostic.
HEYGEN_API_KEY=

# Notion Shorts Archive DB (optional — downstream archive for produce-from-source /
# generate-distribution-copy; see .agents/skills/generate-distribution-copy/references/notion-archive-page.md)
NOTION_SHORTS_ARCHIVE_DATABASE_ID=
NOTION_SHORTS_ARCHIVE_DATA_SOURCE_ID=

# Local MCP outputs
MCP_OUTPUT_DIR=~/.motion-shorts/out

# humanizer repo checkout, used by `bun run copy:gate` to voice-gate LinkedIn copy
# (optional; defaults to ~/Developer/humanizer)
HUMANIZER_REPO_PATH=~/Developer/humanizer

# R2 artifact publishing
R2_ACCOUNT_ID=replace-me
R2_BUCKET=renders

# Gateway transport is sufficient for upload and hydration.
# Direct-S3 write keys are an alternative, not a requirement.
# Your deployed upload-gateway Worker URL + token (apps/infra, Alchemy). Keep the
# real values in your local .env only — this template is public, never pin them here.
R2_UPLOAD_GATEWAY_URL=
R2_UPLOAD_GATEWAY_TOKEN=

# Optional direct-S3 transport alternative
R2_ACCESS_KEY_ID_WRITE=
R2_SECRET_ACCESS_KEY_WRITE=
