{
  "name": "@cgaravitoq/catalog",
  "version": "0.1.0",
  "description": "Machine-readable visual component catalog for Hyperframes shorts.",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun run scripts/build.ts && bun run ../../scripts/generate-catalog-reference.mjs",
    "check": "bun run scripts/check.ts",
    "lint": "biome lint .",
    "list": "bun run scripts/list.ts",
    "route": "bun run scripts/route.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "validate": "bun run scripts/validate.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.6"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
